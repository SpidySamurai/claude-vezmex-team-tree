__pycache__/
*.py[cod]

# Runtime state lives under $XDG_STATE_HOME/herdr/claude-vezmex-team-tree,
# never in the plugin directory — these are only here as a guard in case a
# run is pointed at the source tree.
*.jsonl
config.json
config.README.txt

# Local tooling state, now that the plugin lives in the working directory.
# (Inline comments are not supported in .gitignore — one pattern per line.)
# Pi runtime state
.atl/
# CodeGraph index: per-checkout, never shared between clones
.codegraph/
.claude/
